# Copy this file to .env and fill in your VPN credentials.
# .env is gitignored; never commit credentials.

# --- Mullvad (WireGuard) example ---
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here
# Pin to a specific city/host for run comparability (see gluetun docs for your provider)
SERVER_COUNTRIES=France
# SERVER_CITIES=Paris
# SERVER_HOSTNAMES=fr-par-wg-001.mullvad.net

# --- US profile for CCPA "do not sell" experiments ---
# Duplicate this compose stack with SERVER_COUNTRIES=United States and a separate DB.

# --- Other providers ---
# See https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# for provider-specific variables (OpenVPN, NordVPN, ExpressVPN, etc.)
